# Public URL of the site (used for canonical URLs, sitemap and share images)
NEXT_PUBLIC_SITE_URL=https://zolfar.de

# Contact form — SMTP of the zolfar.de mailbox (Titan: smtp.titan.email, port 465)
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Where messages are delivered, and the sender address (defaults to SMTP_USER)
CONTACT_TO=
CONTACT_FROM=
